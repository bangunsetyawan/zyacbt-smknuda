# Konfigurasi Aplikasi ZyaCBT SMK NU Darussalam
# Gunakan CI_ENV=production saat deploy di server ujian sekolah
CI_ENV=production
APP_PORT=8085
PMA_BIND=127.0.0.1
PMA_PORT=8086
# Kosongkan APP_BASE_URL untuk auto-detect host/port, atau isi misal: https://cbt.smknuda.qzz.io/
APP_BASE_URL=

# Konfigurasi Database MariaDB
DB_HOST=db
DB_NAME=zyacbtpublic
DB_USER=zyacbt
DB_PASS=zyacbt123
DB_ROOT_PASS=rootzyacbt123

# Timezone
TZ=Asia/Jakarta
